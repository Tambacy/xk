# ============================================================================
#  仅本地保留 —— 不进仓库
# ============================================================================
# 早期命令行版（自用脚本）与接口侦察脚本，留在本机即可，不作为交付物
thu_xk/
thu_xk2/

# 开发期的探测脚本（登录耗时、指纹审计、隔离测试等），本机排障用
# 注意：test_*.py 是正式测试，不受影响
xk_app/probe_*.py

# ============================================================================
#  敏感文件 —— 绝不能进 git
#  这些包含明文密码、登录 Cookie、浏览器登录态，一旦推上去就等于把账号送人
# ============================================================================

# 明文账号密码
secrets.json
**/secrets.json
!**/secrets.example.json          # 模板可以提交

# 登录凭据 / Cookie / 设备指纹
credentials.dat
**/credentials.dat
session_cookies.json
**/session_cookies.json
pylogin_cookies.json
**/pylogin_cookies.json
device_fingerprint.json
**/device_fingerprint.json

# 浏览器 profile（里面有登录态）
browser_profile/
**/browser_profile/
_probe_chromium_new/
_probe_edge_new/
# 探测过程留下的临时浏览器目录（每个几百 MB）
_fresh_*/
**/_fresh_*/
**/_probe_*/

# ============================================================================
#  运行数据与构建产物 —— 不该进 git
# ============================================================================

# 运行数据目录（日志、测试用的 profile 等，体积很大且含登录态）
xk_app/data/
data/
logs/
diagnostics/

# 打包产物（几百 MB，重新构建即可）
xk_app/dist/
xk_app/build/
xk_app/installer/
dist/
build/
installer/
*.spec.bak

# 界面渲染截图
shots/

